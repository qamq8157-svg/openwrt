#!/bin/bash

# 1. 强制将默认主题设置为 Argon
sed -i 's/luci-theme-bootstrap/luci-theme-argon/g' feeds/luci/collections/luci/Makefile

# 2. 预置 ddnsto 远程令牌（请把下面引号里的内容换成你的真实令牌）
mkdir -p package/base-files/files/etc/config
cat << 'EOF' > package/base-files/files/etc/config/ddnsto
config ddnsto 'config'
	option enabled '1'
	option token 'beda0b77-9b22-4c88-a685-f0c0ec1a27b6'
EOF

# 3. 在后台菜单中隐藏 ddnsto
if [ -f "package/nas-packages-luci/luci-app-ddnsto/luasrc/controller/ddnsto.lua" ]; then
    sed -i 's/page({"admin", "services", "ddnsto"/-- page({"admin", "services", "ddnsto"/g' package/nas-packages-luci/luci-app-ddnsto/luasrc/controller/ddnsto.lua
fi
